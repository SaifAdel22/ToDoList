@{
    ViewData["Title"] = "Select User";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card p-4 shadow-sm text-center">
        <h3 class="mb-4">Task Tracker</h3>

        <form method="get" asp-action="UserTasks">
            <div class="mb-3 text-start">
                <label class="form-label fw-bold">Select User:</label>
                <select name="id" class="form-select form-select-lg" asp-items="ViewBag.UsersList" required>
                    <option value="">-- Choose a User --</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100">Show Tasks</button>
        </form>
    </div>
</div>