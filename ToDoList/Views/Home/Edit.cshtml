@model ToDoList.ViewModels.EditVM

@{
    ViewData["Title"] = "Edit Task";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow-sm p-4 border-0 rounded-3">
        <h3 class="mb-4 text-center fw-bold text-primary">Edit Task</h3>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="FilePath" />

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-bold">Title</label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Deadline" class="form-label fw-bold">Deadline</label>
                <input asp-for="Deadline" class="form-control" type="date" />
                <span asp-validation-for="Deadline" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsCompleted" class="form-check-input" type="checkbox" id="isCompletedCheck" />
                <label class="form-check-label fw-bold" for="isCompletedCheck">
                    Mark as Completed
                </label>
            </div>

            <div class="mb-4">
                <label asp-for="TaskFile" class="form-label fw-bold">Attachment</label>
                @if (!string.IsNullOrEmpty(Model.FilePath))
                {
                    <div class="mb-2">
                        <small class="text-muted">Current File: </small>
                        <a href="@Model.FilePath" target="_blank" class="btn btn-sm btn-outline-info me-2">View Existing File</a>
                    </div>
                }
                <input asp-for="TaskFile" class="form-control" type="file" />
                <small class="text-muted d-block mt-1">Leave empty if you don't want to replace the current file.</small>
            </div>

            <div class="d-flex justify-content-between">
                <a asp-action="UserTasks" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary px-4">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}